{
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "corrections", "reason"],
  "properties": {
    "result": {"type": "string", "enum": ["ACCEPT", "CORRECT", "UNRESOLVED"]},
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "status"],
        "properties": {
          "condition_id": {"type": "string"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"]}
        }
      }
    },
    "reason": {"type": "string"}
  }
}
