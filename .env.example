# PostgreSQL connection used by FastAPI, the worker, and Alembic.
DATABASE_URL=postgresql+asyncpg://solverthon:change-me@127.0.0.1:5432/solverthon
# Browser origin allowed for session and CSRF checks.
APP_ORIGIN=http://localhost:5173
# Generate a private value of at least 32 random bytes. Never commit it.
SESSION_SECRET=
# Production must use Secure session cookies. Keep false only for local HTTP development.
SESSION_COOKIE_SECURE=false
# Official Bizinfo API credential. Never commit it.
BIZINFO_API_KEY=
# Writable local storage for source attachments.
SOURCE_STORAGE_ROOT=./storage/sources
# Fixture manifest root used for demos and automated tests.
DEMO_FIXTURE_ROOT=./fixtures/demo
APP_TIMEZONE=Asia/Seoul
AI_MAX_CONCURRENCY=5
AI_STAGE_TIMEOUT_SECONDS=300
VITE_API_BASE=/api/v1
# Path to an ignored local cloudflared config.
CLOUDFLARE_TUNNEL_CONFIG=./infra/cloudflared/config.local.yml
