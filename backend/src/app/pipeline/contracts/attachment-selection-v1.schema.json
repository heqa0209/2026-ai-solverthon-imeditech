{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ranked_attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_order": {"type": "integer", "minimum": 0},
          "prioritized": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "required": ["source_order", "prioritized", "reason"]
      }
    }
  },
  "required": ["ranked_attachments"]
}
